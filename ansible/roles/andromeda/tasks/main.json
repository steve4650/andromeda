[
  {
    "tags": "andromeda",
    "block": [
      {
        "name": "Create /etc/wireguard directory",
        "ansible.builtin.file": {
          "path": "/etc/wireguard",
          "state": "directory",
          "mode": "0700",
          "owner": "root",
          "group": "root"
        },
        "become": "yes"
      },
      {
        "name": "Install WireGuard interface configuration",
        "ansible.builtin.template": {
          "src": "andromeda.conf",
          "dest": "/etc/wireguard/andromeda.conf",
          "owner": "root",
          "group": "root",
          "mode": "0600",
          "backup": true
        },
        "become": "yes"
      },
      {
        "name": "Install Andromeda private key",
        "ansible.builtin.template": {
          "src": "ischia.priv",
          "dest": "/etc/wireguard/ischia.priv",
          "owner": "root",
          "group": "root",
          "mode": "0600",
          "backup": true
        },
        "become": "yes"
      },
      {
        "name": "Install Andromeda public key",
        "ansible.builtin.template": {
          "src": "ischia.pub",
          "dest": "/etc/wireguard/ischia.pub",
          "owner": "root",
          "group": "root",
          "mode": "0600",
          "backup": true
        },
        "become": "yes"
      },
      {
        "name": "Create andromeda OpenRC service",
        "ansible.builtin.copy": {
          "src": "andromeda_openrc",
          "dest": "/etc/init.d/andromeda",
          "mode": "0755",
          "owner": "root",
          "group": "root",
          "backup": true
        },
        "register": "andromeda_service",
        "become": "yes"
      },
      {
        "name": "Enable and start andromeda service",
        "ansible.builtin.service": {
          "name": "andromeda",
          "enabled": true,
          "state": "started"
        },
        "when": "andromeda_service.changed",
        "become": "yes"
      },
      {
        "name": "Create /home/steve/.local directory",
        "ansible.builtin.file": {
          "path": "/home/steve/.local",
          "state": "directory",
          "mode": "0755",
          "owner": "steve",
          "group": "steve"
        },
        "become": "yes"
      },
      {
        "name": "Create /home/steve/.local/bin directory",
        "ansible.builtin.file": {
          "path": "/home/steve/.local/bin",
          "state": "directory",
          "mode": "0755",
          "owner": "steve",
          "group": "steve"
        },
        "become": "yes"
      },
      {
        "name": "Clone ischia repository",
        "ansible.builtin.git": {
          "repo": "https://github.com/steve4650/ischia.git",
          "dest": "/home/steve/.local/bin/ischia",
          "clone": true
        },
        "become": "yes"
      },
      {
        "name": "Install VPN update cron job for steve",
        "ansible.builtin.cron": {
          "name": "Update Cloudflare IPv4 DNS record",
          "user": "steve",
          "minute": "1,16,31,46",
          "job": "CLOUDFLARE_API_TOKEN=\"{{ CLOUDFLARE_API_TOKEN }}\" A_DNS_RECORD_ID=\"{{ A_DNS_RECORD_ID }}\" ZONE_ID=\"{{ ZONE_ID }}\" uv run ansible/roles/andromeda/files/vpn_update.py --ipv4-only"
        },
        "become": "yes"
      }

    ]
  }
]
