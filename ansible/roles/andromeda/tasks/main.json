[
  {
    "tags": "andromeda",
    "block": [
      {
        "name": "Create /etc/wireguard directory",
        "ansible.builtin.file": {
          "path": "/etc/wireguard",
          "state": "directory",
          "mode": "0700",
          "owner": "root",
          "group": "root",
          "seuser": "system_u",
          "serole": "object_r",
          "setype": "etc_t",
          "selevel": "s0"
        },
        "become": "yes"
      },
      {
        "name": "Install WireGuard interface configuration",
        "ansible.builtin.template": {
          "src": "andromeda_conf",
          "dest": "/etc/wireguard/andromeda.conf",
          "owner": "root",
          "group": "root",
          "mode": "0600",
          "seuser": "system_u",
          "serole": "object_r",
          "setype": "etc_t",
          "selevel": "s0",
          "backup": true
        },
        "become": "yes"
      },
      {
        "name": "Create andromeda OpenRC service",
        "ansible.builtin.copy": {
          "src": "andromeda_openrc",
          "dest": "/etc/init.d/andromeda",
          "mode": "0755",
          "owner": "root",
          "group": "root",
          "backup": true
        },
        "register": "andromeda_openrc_service",
        "become": "yes",
        "when": "ansible_facts['os_family'] == 'Alpine'"
      },
      {
        "name": "Create andromeda systemd service",
        "ansible.builtin.copy": {
          "src": "andromeda.service",
          "dest": "/etc/systemd/system/andromeda.service",
          "mode": "0600",
          "owner": "root",
          "group": "root",
          "seuser": "system_u",
          "serole": "object_r",
          "setype": "systemd_unit_file_t",
          "selevel": "s0"
        },
        "register": "andromeda_systemd_service",
        "become": "yes",
        "when": "ansible_facts['os_family'] != 'Alpine'"
      },

      {
        "name": "Enable and start andromeda service",
        "ansible.builtin.service": {
          "name": "andromeda",
          "enabled": true,
          "state": "started"
        },
        "when": "andromeda_systemd_service.changed or andromeda_openrc_service.changed",
        "become": "yes"
      },

      {
        "name": "Clone ischia repository",
        "ansible.builtin.git": {
          "repo": "https://github.com/steve4650/ischia.git",
          "dest": "/home/steve/.local/bin/ischia",
          "clone": true
        },
        "become": "yes",
        "become_user": "steve",
        "when": "ansible_hostname in groups['ischia']"
      },
      {
        "name": "Install VPN update cron job for steve",
        "ansible.builtin.cron": {
          "name": "Update Cloudflare IPv4 DNS record",
          "user": "steve",
          "minute": "1,16,31,46",
          "job": "CLOUDFLARE_API_TOKEN=\"{{ CLOUDFLARE_API_TOKEN }}\" A_DNS_RECORD_ID=\"{{ A_DNS_RECORD_ID }}\" ZONE_ID=\"{{ ZONE_ID }}\" uv --directory /home/steve/.local/bin/ischia/ansible/roles/andromeda/files run vpn_update.py --ipv4-only"
        },
        "become": "yes",
        "when": "ansible_hostname in groups['ischia']"
      }
    ]
  }
]
