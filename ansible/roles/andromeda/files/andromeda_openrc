#!/sbin/openrc-run
description="Andromeda WireGuard VPN"

depend() {
    need net
    use dns
}

start() {
    ebegin "Starting andromeda"
    /usr/bin/wg-quick up /etc/wireguard/andromeda.conf
    eend $?
}

stop() {
    ebegin "Stopping andromeda"
    /usr/bin/wg-quick down /etc/wireguard/andromeda.conf
    eend $?
}