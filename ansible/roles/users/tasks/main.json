[
  {
    "tags": "users",
    "block": [
      {
        "name": "Create steve user in wheel group",
        "ansible.builtin.user": {
          "name": "steve",
          "groups": "wheel",
          "append": true
        },
        "become": "yes"
      },
      {
        "name": "Create gnuplex",
        "ansible.builtin.user": {
          "name": "gnuplex"
        },
        "become": "yes"
      },
      {
        "name": "install steve zshrc",
        "ansible.builtin.copy": {
          "src": "zshrc",
          "dest": "/home/steve/.zshrc",
          "owner": "steve",
          "group": "steve",
          "mode": "0644"
        },
        "become": "yes"
      },
      {
        "name": "install gnuplex zshrc",
        "ansible.builtin.copy": {
          "src": "zshrc",
          "dest": "/home/gnuplex/.zshrc",
          "owner": "gnuplex",
          "group": "gnuplex",
          "mode": "0644"
        },
        "become": "yes"
      }
    ]
  }
]
