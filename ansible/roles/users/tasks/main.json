[
  {
    "tags": "users",
    "block": [
      {
        "name": "Create steve user in wheel group",
        "ansible.builtin.user": {
          "name": "steve",
          "groups": "wheel",
          "append": true
        },
        "become": "yes"
      },
      {
        "name": "Create deploy user",
        "ansible.builtin.user": {
          "name": "deploy"
        },
        "become": "yes",
        "when": "ansible_facts['hostname'] in groups['davisgroup_uk_group']"
      },
      {
        "name": "Create gnuplex user",
        "ansible.builtin.user": {
          "name": "gnuplex"
        },
        "become": "yes",
        "when": "ansible_facts['hostname'] in groups['ischia_group']"
      },
      {
        "name": "Create git user",
        "ansible.builtin.user": {
          "name": "git",
          "shell": "/usr/bin/git-shell"
        },
        "become": "yes",
        "when": "ansible_facts['hostname'] in groups['ischia_group']"
      },
      {
        "name": "install steve zshrc",
        "ansible.builtin.copy": {
          "src": "zshrc_steve",
          "dest": "/home/steve/.zshrc",
          "owner": "steve",
          "group": "steve",
          "mode": "0644",
          "backup": true
        },
        "become": "yes"
      },
      {
        "name": "install gnuplex zshrc",
        "ansible.builtin.copy": {
          "src": "zshrc_gnuplex",
          "dest": "/home/gnuplex/.zshrc",
          "owner": "gnuplex",
          "group": "gnuplex",
          "mode": "0644",
          "backup": true
        },
        "become": "yes",
        "when": "ansible_facts['hostname'] in groups['ischia_group']"
      },
      {
        "name": "install steve gitconfig",
        "ansible.builtin.copy": {
          "src": "gitconfig",
          "dest": "/home/steve/.gitconfig",
          "owner": "steve",
          "group": "steve",
          "mode": "0644",
          "backup": true
        },
        "become": "yes"
      },
      {
        "name": "Create /home/steve/.local directory",
        "ansible.builtin.file": {
          "path": "/home/steve/.local",
          "state": "directory",
          "mode": "0755",
          "owner": "steve",
          "group": "steve"
        },
        "become": "yes"
      },
      {
        "name": "Create /home/steve/.local/bin directory",
        "ansible.builtin.file": {
          "path": "/home/steve/.local/bin",
          "state": "directory",
          "mode": "0755",
          "owner": "steve",
          "group": "steve"
        },
        "become": "yes"
      }
    ]
  }
]
