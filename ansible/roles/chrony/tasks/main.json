[
  {
    "tags": "chrony",
    "block": [
      {
        "name": "Copy chrony.conf into place (davisgroup.uk)",
        "ansible.builtin.copy": {
          "src": "chrony.conf",
          "dest": "/etc/chrony.conf",
          "owner": "root",
          "group": "root",
          "mode": "0644",
          "seuser": "system_u",
          "serole": "object_r",
          "setype": "etc_t",
          "selevel": "s0",
          "backup": true
        },
        "register": "chronyconf",
        "become": "yes",
        "when": "ansible_facts['hostname'] in groups['davisgroup_uk_group']"
      },
      {
        "name": "Copy chrony.conf into place (ischia)",
        "ansible.builtin.copy": {
          "src": "chrony.conf",
          "dest": "/etc/chrony/chrony.conf",
          "owner": "root",
          "group": "root",
          "mode": "0644",
          "backup": true
        },
        "register": "chronyconf",
        "become": "yes",
        "when": "ansible_facts['hostname'] in groups['ischia_group']"
      },

      {
        "name": "Disable ntpd service",
        "ansible.builtin.service": {
          "name": "ntpd",
          "state": "stopped",
          "enabled": false
        },
        "become": "yes",
        "when": "ansible_facts['os_family'] == 'Alpine'"
      },
      {
        "name": "Enable chronyd service",
        "ansible.builtin.service": {
          "name": "chronyd",
          "state": "restarted",
          "enabled": true
        },
        "when": "chronyconf.changed",
        "become": "yes"
      }
    ]
  }
]
