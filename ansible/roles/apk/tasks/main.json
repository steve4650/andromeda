[
  {
    "tags": "dnf",
    "block": [
      {
        "name": "update apk repo config",
        "ansible.builtin.copy": {
          "src": "repositories",
          "dest": "/etc/apk/repositories",
          "owner": "root",
          "group": "root",
          "mode": "0644",
          "backup": true
        },
        "become": "yes"
      },
      {
        "name": "Install apk packages",
        "ansible.builtin.package": {
          "name": [
            "caddy",
            "chrony",
            "wireguard-tools",
            "git",
            "rsync",
            "sway",
            "firefox",
            "zsh",
            "mpv",
            "pipewire",
            "wireplumber",
            "doas"
          ],
          "state": "present"
        },
        "become": "yes"
      }
    ]
  }
]
